{
  "expo": {
    "name": "StarWatch",
    "slug": "starwatch",
    "version": "1.2.0",
    "orientation": "default",
    "scheme": "starwatch",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#05070D",
    "splash": {
      "backgroundColor": "#05070D"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.lvqstd.starwatch"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#05070D"
      },
      "package": "dev.lvqstd.starwatch"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "lang": "vi",
      "themeColor": "#05070D",
      "favicon": "./assets/favicon.png",
      "name": "StarWatch · Chạm vào Vũ Trụ",
      "shortName": "StarWatch",
      "description": "Dự báo săn Ngân Hà, săn mây, vòm trời 3D và bản đồ ô nhiễm sáng Bortle."
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
